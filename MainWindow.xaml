<Window x:Class="MiniHardwareWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:MiniHardwareWidget.Converters"
        xmlns:viewmodels="clr-namespace:MiniHardwareWidget.ViewModels"
        mc:Ignorable="d"
        Title="PC Monitor"
        SizeToContent="Height"
        MinHeight="440"
        Width="290"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="{Binding IsAlwaysOnTop}"
        MouseDown="Window_MouseDown">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <converters:TempToColorConverter x:Key="TempColorConverter" />
        <converters:SpeedFormatterConverter x:Key="SpeedConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BoolVisConverter" />
        <converters:BooleanToVisibilityConverter x:Key="InverseBoolVisConverter" Invert="True" />

        <!-- Glow effect -->
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000" />
        <DropShadowEffect x:Key="CardShadow" BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="#000000" />

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8E92A4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="Background" Value="#252A38" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Context Menu -->
    <Window.ContextMenu>
        <ContextMenu Background="#1A1D26" Foreground="#E0E2EC" BorderBrush="#2D3244">
            <MenuItem Header="Поверх всех окон" IsCheckable="True" IsChecked="{Binding IsAlwaysOnTop, Mode=TwoWay}" />
            <MenuItem Header="Сбросить счетчик энергии (кВт·ч)" Click="ResetEnergy_Click" />
            <Separator Background="#2D3244" />
            <MenuItem Header="Запустить от имени Администратора" Click="RestartAdmin_Click" />
            <Separator Background="#2D3244" />
            <MenuItem Header="Закрыть виджет" Click="CloseButton_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Main Outer Container -->
    <Border Margin="10" CornerRadius="16" Background="#CC111319" BorderBrush="#353B4F" BorderThickness="1.2" Effect="{StaticResource WindowShadow}">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <!-- 0: Header -->
                <RowDefinition Height="Auto" />
                <!-- 1: CPU & GPU -->
                <RowDefinition Height="Auto" />
                <!-- 2: Power & Fans -->
                <RowDefinition Height="Auto" />
                <!-- 3: Network Ethernet -->
                <RowDefinition Height="Auto" />
                <!-- 4: VPN (Happ) -->
                <RowDefinition Height="Auto" />
                <!-- 5: Admin notice banner (if needed) -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Status dot -->
                    <Ellipse Width="7" Height="7" Fill="#4ECCA3" Margin="0,0,8,0">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#4ECCA3" Opacity="0.8" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="PC MONITOR" Foreground="#A0A5BA" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Window Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Width="24" Height="24" ToolTip="Закрепить поверх окон" Click="TogglePin_Click">
                        <TextBlock Text="📌" FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="24" Height="24" Margin="2,0,0,0" ToolTip="Свернуть" Click="MinimizeButton_Click">
                        <TextBlock Text="—" FontSize="11" FontWeight="Bold" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="24" Height="24" Margin="2,0,0,0" ToolTip="Закрыть" Click="CloseButton_Click">
                        <TextBlock Text="✕" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- CPU & GPU SECTION -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU CARD -->
                <Border Grid.Column="0" CornerRadius="10" Background="#181B24" BorderBrush="#262A38" BorderThickness="1" Padding="10" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="CPU" Foreground="#00E5FF" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="{Binding CpuLoadText}" Foreground="#8C91A4" FontSize="10" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding CpuName}" Foreground="#686E82" FontSize="9.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,4" />

                        <Viewbox MaxHeight="28" HorizontalAlignment="Left" Margin="0,2,0,2">
                            <TextBlock Text="{Binding CpuTempText}" Foreground="{Binding CpuTempRaw, Converter={StaticResource TempColorConverter}}" FontSize="20" FontWeight="Bold" />
                        </Viewbox>

                        <TextBlock Text="{Binding CpuPowerText}" Foreground="#8C91A4" FontSize="10.5" />
                    </StackPanel>
                </Border>

                <!-- GPU CARD -->
                <Border Grid.Column="2" CornerRadius="10" Background="#181B24" BorderBrush="#262A38" BorderThickness="1" Padding="10" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="GPU" Foreground="#76B900" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="{Binding GpuLoadText}" Foreground="#8C91A4" FontSize="10" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding GpuName}" Foreground="#686E82" FontSize="9.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,4" />

                        <Viewbox MaxHeight="28" HorizontalAlignment="Left" Margin="0,2,0,2">
                            <TextBlock Text="{Binding GpuTempText}" Foreground="{Binding GpuTempRaw, Converter={StaticResource TempColorConverter}}" FontSize="20" FontWeight="Bold" />
                        </Viewbox>

                        <TextBlock Text="{Binding GpuPowerText}" Foreground="#8C91A4" FontSize="10.5" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- POWER & FANS SECTION -->
            <Border Grid.Row="2" CornerRadius="10" Background="#181B24" BorderBrush="#262A38" BorderThickness="1" Padding="11,9" Margin="0,0,0,10" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 1: Total Power & Energy -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="11" Foreground="#FFD369" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="ПОТРЕБЛЕНИЕ" Foreground="#8C91A4" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding TotalWattsText}" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Bottom" />
                                <TextBlock Text=" (Σ)" Foreground="#686E82" FontSize="10" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Accumulated Energy -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="ЭНЕРГИЯ" Foreground="#8C91A4" FontSize="9" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding WattHoursText}" Foreground="#FFD369" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <Separator Grid.Row="1" Background="#262A38" Margin="0,8,0,7" />

                    <!-- Row 2: Fans -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="🌀" FontSize="11" Foreground="#00E5FF" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding GpuFanText}" Foreground="#B4B9CB" FontSize="10.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ETHERNET PORT & NETWORK SECTION -->
            <Border Grid.Row="3" CornerRadius="10" Background="#181B24" BorderBrush="#262A38" BorderThickness="1" Padding="11,9" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <!-- Header of network block -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🌐" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NetworkName}" Foreground="#B4B9CB" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Link speed badge -->
                        <Border HorizontalAlignment="Right" CornerRadius="5" Background="#1A2D2A" BorderBrush="#29574E" BorderThickness="1" Padding="5,1">
                            <TextBlock Text="{Binding NetworkSpeedText}" Foreground="#4ECCA3" FontSize="9.5" FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <!-- Realtime Download / Upload speeds -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Download -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="↓" Foreground="#4ECCA3" FontSize="12" FontWeight="Bold" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding DownloadSpeedRaw, Converter={StaticResource SpeedConverter}}" Foreground="#E0E2EC" FontSize="10.5" />
                        </StackPanel>

                        <!-- Upload -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="↑" Foreground="#00E5FF" FontSize="12" FontWeight="Bold" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding UploadSpeedRaw, Converter={StaticResource SpeedConverter}}" Foreground="#E0E2EC" FontSize="10.5" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- VPN SECTION (Visible only when VPN tunnel is Up) -->
            <Border Grid.Row="4" CornerRadius="10" Background="#181B24" BorderBrush="#3B2A59" BorderThickness="1" Padding="11,9" Margin="0,8,0,0"
                    Visibility="{Binding IsVpnActive, Converter={StaticResource BoolVisConverter}}" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <!-- Header of VPN block -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🛡️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding VpnTitle}" Foreground="#D8B4FE" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Country / Location Badge from Happ -->
                        <Border HorizontalAlignment="Right" CornerRadius="5" Background="#2A1B44" BorderBrush="#6B3FA0" BorderThickness="1" Padding="6,2">
                            <TextBlock Text="{Binding VpnCountryText}" Foreground="#D8B4FE" FontSize="9.5" FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <!-- Realtime Download / Upload speeds for VPN -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Download -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="↓" Foreground="#A855F7" FontSize="12" FontWeight="Bold" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding VpnDownloadSpeedRaw, Converter={StaticResource SpeedConverter}}" Foreground="#E0E2EC" FontSize="10.5" />
                        </StackPanel>

                        <!-- Upload -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="↑" Foreground="#EC4899" FontSize="12" FontWeight="Bold" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding VpnUploadSpeedRaw, Converter={StaticResource SpeedConverter}}" Foreground="#E0E2EC" FontSize="10.5" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ADMIN NOTICE BADGE (Visible only if NOT run as administrator) -->
            <Border Grid.Row="5" Margin="0,8,0,0" CornerRadius="6" Background="#261E16" BorderBrush="#5E4327" BorderThickness="1" Padding="6,4"
                    Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolVisConverter}}"
                    Cursor="Hand" MouseLeftButtonUp="AdminBadge_Click" ToolTip="Нажмите для перезапуска с правами администратора">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Text="Запустить от админа для датчиков кулеров" Foreground="#FFB067" FontSize="9.5" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
